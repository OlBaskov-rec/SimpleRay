<Window x:Class="SimpleRay.App.SubscriptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SimpleRay.App.Localization"
        Title="{loc:Loc subs.title}" Height="460" Width="680" MinHeight="320" MinWidth="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" Grid.Column="0" ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Shown over the empty list -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc subs.empty}" Foreground="Gray"
                   TextWrapping="Wrap" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" MinWidth="140">
            <Button Content="{loc:Loc subs.add}" Command="{Binding AddCommand}" Padding="10,4" Margin="0,0,0,6"
                    ToolTipService.ShowDuration="60000">
                <Button.ToolTip>
                    <TextBlock Text="{loc:Loc tip.subscriptionAdd}" TextWrapping="Wrap" MaxWidth="460" />
                </Button.ToolTip>
            </Button>
            <Button Content="{loc:Loc subs.refresh}" Command="{Binding RefreshCommand}" Padding="10,4" Margin="0,0,0,6" />
            <Button Content="{loc:Loc subs.refreshAll}" Command="{Binding RefreshAllCommand}" Padding="10,4" Margin="0,0,0,6" />
            <Button Content="{loc:Loc subs.edit}" Command="{Binding EditCommand}" Padding="10,4" Margin="0,0,0,6" />
            <!-- Provider links (support-url / profile-web-page-url); disabled when not sent -->
            <Button Content="{loc:Loc sub.support}" Command="{Binding OpenSupportCommand}" Padding="10,4" Margin="0,12,0,6" />
            <Button Content="{loc:Loc sub.website}" Command="{Binding OpenWebPageCommand}" Padding="10,4" Margin="0,0,0,6" />
            <Button Content="{loc:Loc subs.remove}" Command="{Binding RemoveCommand}" Padding="10,4" Margin="0,12,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Host.StatusText}" Foreground="#333"
                   TextWrapping="Wrap" Margin="2,10,0,0" />

        <Button Grid.Row="2" Grid.ColumnSpan="2" Content="{loc:Loc common.done}" IsCancel="True"
                HorizontalAlignment="Right" Padding="16,5" Margin="0,10,0,0" Click="Done_Click" />
    </Grid>
</Window>
