<Window x:Class="SimpleRay.App.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SimpleRay.App.Localization"
        Title="Ввод" Height="176" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14">
        <TextBlock x:Name="PromptText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#444" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Width="84" Padding="0,4" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="{loc:Loc common.cancel}" IsCancel="True" Width="84" Padding="0,4" />
        </StackPanel>
        <TextBox x:Name="Input" VerticalAlignment="Top" Padding="4,3" />
    </DockPanel>
</Window>
