<Window x:Class="SimpleRay.App.WebcamQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SimpleRay.App.Localization"
        Title="{loc:Loc webcam.title}" Height="540" Width="660"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#555"
                   Text="{loc:Loc webcam.hint}" />
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666" />
            <Button Content="{loc:Loc common.cancel}" IsCancel="True" HorizontalAlignment="Right" Padding="16,5" />
        </Grid>
        <Border Background="#111" CornerRadius="4">
            <Image x:Name="Preview" Stretch="Uniform" Margin="4" />
        </Border>
    </DockPanel>
</Window>
