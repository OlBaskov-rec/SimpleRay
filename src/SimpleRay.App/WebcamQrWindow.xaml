<Window x:Class="SimpleRay.App.WebcamQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сканирование QR с камеры" Height="540" Width="660"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#555"
                   Text="Наведите камеру на QR-код профиля — распознавание произойдёт автоматически." />
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666" />
            <Button Content="Отмена" IsCancel="True" HorizontalAlignment="Right" Padding="16,5" />
        </Grid>
        <Border Background="#111" CornerRadius="4">
            <Image x:Name="Preview" Stretch="Uniform" Margin="4" />
        </Border>
    </DockPanel>
</Window>
