<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SimpleRay.Core\SimpleRay.Core.csproj" />
  </ItemGroup>

  <!-- Bundled runtime deps (sing-box.exe, wintun.dll, geo *.srs) are fetched by
       scripts\fetch-deps.ps1 into runtime\ and copied next to the exe as core\ / geo\. -->
  <ItemGroup>
    <None Include="runtime\**\*" Exclude="runtime\**\config.json">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Keep these as real files beside the exe for `dotnet run`/Debug, but DON'T let the
           single-file publish bundler embed sing-box.exe/wintun.dll. The publish script copies
           core\ and geo\ next to the published exe explicitly. -->
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <!-- Tray / window icon (embedded as a WPF resource, addressable via pack URI). -->
  <ItemGroup>
    <Resource Include="Resources\tray.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 TFM unlocks WinRT (Windows.Media.Capture) for live webcam QR. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\tray.ico</ApplicationIcon>
    <RootNamespace>SimpleRay.App</RootNamespace>
    <AssemblyName>SimpleRay</AssemblyName>

    <!-- Product version (source of truth for the in-app updater; compared to GitHub release tag). -->
    <Version>0.1.0</Version>
    <Company>OlBaskov-rec</Company>
    <Product>SimpleRay</Product>
  </PropertyGroup>

</Project>
