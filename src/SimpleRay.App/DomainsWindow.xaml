<Window x:Class="SimpleRay.App.DomainsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SimpleRay.App.Localization"
        Title="{loc:Loc domains.title}" Height="360" Width="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#444"
                   Text="{loc:Loc domains.hint}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Width="84" Padding="0,4" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="{loc:Loc common.cancel}" IsCancel="True" Width="84" Padding="0,4" />
        </StackPanel>
        <TextBox x:Name="Input" AcceptsReturn="True" AcceptsTab="False" Padding="4,3"
                 FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
    </DockPanel>
</Window>
