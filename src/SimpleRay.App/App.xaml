<Application x:Class="SimpleRay.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SimpleRay.App"
             xmlns:infra="clr-namespace:SimpleRay.App.Infrastructure">
    <Application.Resources>
        <!-- Every tooltip in the app: larger text, wrapped, and structured by RichTip (a multi-line
             tip's first line is a bold headline). Tooltips are set as plain strings everywhere. -->
        <Style TargetType="ToolTip">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <infra:RichTip Source="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
