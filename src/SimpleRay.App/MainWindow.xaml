<Window x:Class="SimpleRay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:loc="clr-namespace:SimpleRay.App.Localization"
        Title="SimpleRay" Height="560" Width="760"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/tray.ico"
        StateChanged="Window_StateChanged"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- System tray icon (not rendered in the layout) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="{Binding TrayIcon}"
                        ToolTipText="{Binding TrayToolTip}"
                        TrayMouseDoubleClick="Tray_ShowWindow">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Loc tray.show}" Click="Tray_ShowWindow" />
                    <MenuItem Header="{loc:Loc tray.toggle}" Click="Tray_ToggleConnect" />
                    <MenuItem Header="{loc:Loc tray.checkUpdates}" Click="Tray_CheckUpdates" />
                    <MenuItem Header="{loc:Loc about.button}" Click="About_Click" />
                    <Separator />
                    <MenuItem Header="{loc:Loc tray.exit}" Click="Tray_Exit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Profile list -->
        <ListBox Grid.Row="0" Grid.Column="0"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <!-- Name; the connected server is highlighted green + bold. -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" FontSize="11" Foreground="#3FB950" VerticalAlignment="Center"
                                       Margin="0,0,4,0"
                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Tag}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold" />
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Foreground="Gray" FontSize="11">
                            <Run Text="{Binding Protocol}" />
                            <Run Text=" · " />
                            <Run Text="{Binding Server}" />
                            <Run Text=":" />
                            <Run Text="{Binding Port}" />
                        </TextBlock>
                        <TextBlock Text="{loc:Loc profile.insecure}" FontSize="11" Foreground="#C0392B"
                                   Visibility="{Binding SkipsCertCheck, Converter={StaticResource BoolToVis}}"
                                   ToolTip="{loc:Loc tip.insecure}" />
                        <!-- "In group" checkbox with the ping latency on the same line, latency indented to the right. -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <CheckBox Content="{loc:Loc profile.inGroup}" FontSize="11" VerticalAlignment="Center"
                                      IsChecked="{Binding InGroup, Mode=TwoWay}"
                                      Command="{Binding DataContext.GroupChangedCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      ToolTip="{loc:Loc tip.inGroup}" />
                            <TextBlock FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding LatencyText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- Reachable: green ms. Unreachable: gray dash. Never pinged: hidden. -->
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LatencyMs}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="Gray" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LatencyText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Profile actions -->
        <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
            <Button Content="{loc:Loc import.clipboard}" Command="{Binding ImportClipboardCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="{loc:Loc tip.importClipboard}" />
            <Button Content="{loc:Loc import.file}" Command="{Binding ImportFileCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="{loc:Loc tip.importFile}" />
            <Button Content="{loc:Loc import.qrFile}" Command="{Binding ImportQrFileCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="{loc:Loc tip.qrFile}" />
            <Button Content="{loc:Loc import.qrClipboard}" Command="{Binding ImportQrClipboardCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="{loc:Loc tip.qrClipboard}" />
            <Button Content="{loc:Loc import.qrWebcam}" Command="{Binding ImportQrWebcamCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="{loc:Loc tip.qrWebcam}" />
            <Button Content="{loc:Loc subscription.add}" Command="{Binding AddSubscriptionCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="{loc:Loc tip.subscriptionAdd}" />
            <Button Content="{loc:Loc subscription.refresh}" Command="{Binding RefreshSubscriptionsCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="{loc:Loc tip.subscriptionRefresh}" />
            <Button Content="{loc:Loc profile.ping}" Command="{Binding PingCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="{loc:Loc tip.ping}" />
            <Button Content="{loc:Loc profile.rename}" Command="{Binding RenameCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="{loc:Loc tip.rename}" />
            <Button Content="{loc:Loc profile.remove}" Command="{Binding RemoveCommand}"
                    Padding="10,4" Margin="0,0,0,6" />
        </WrapPanel>

        <!-- Right panel -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="{Binding ConnectButtonText}"
                    Command="{Binding ConnectCommand}"
                    Height="44" FontSize="15" FontWeight="SemiBold" />

            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="2,10"
                       TextWrapping="Wrap" Foreground="#333" />

            <!-- Routing settings -->
            <GroupBox Grid.Row="2" Header="{loc:Loc routing.title}" Padding="8,4" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Loc routing.mode}" Foreground="#666" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding Modes}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding SelectedMode, Mode=TwoWay}" />

                    <CheckBox Content="{loc:Loc routing.blockAds}"
                              IsChecked="{Binding BlockAds, Mode=TwoWay}"
                              Margin="0,10,0,0" />

                    <CheckBox Content="{loc:Loc routing.autoConnect}"
                              IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                              ToolTip="{loc:Loc tip.autoConnect}" Margin="0,6,0,0" />

                    <CheckBox Content="{loc:Loc routing.killSwitch}"
                              IsChecked="{Binding KillSwitchEnabled, Mode=TwoWay}"
                              ToolTip="{loc:Loc tip.killSwitch}" Margin="0,6,0,0" />

                    <CheckBox Content="{loc:Loc routing.enableIpv6}"
                              IsChecked="{Binding EnableIpv6, Mode=TwoWay}"
                              ToolTip="{loc:Loc tip.enableIpv6}" Margin="0,6,0,0" />

                    <TextBlock Text="{loc:Loc routing.directHint}"
                               Foreground="#666" Margin="0,10,0,2" TextWrapping="Wrap" />
                    <CheckBox Content="{loc:Loc routing.directRuSites}"
                              IsChecked="{Binding DirectRuSites, Mode=TwoWay}"
                              IsEnabled="{Binding IsRuleMode}" Margin="0,2,0,0" />
                    <CheckBox Content="{loc:Loc routing.directRuIp}"
                              IsChecked="{Binding DirectRuIp, Mode=TwoWay}"
                              IsEnabled="{Binding IsRuleMode}" Margin="0,2,0,0" />
                    <CheckBox Content="{loc:Loc routing.directLan}"
                              IsChecked="{Binding DirectLan, Mode=TwoWay}"
                              IsEnabled="{Binding IsRuleMode}" Margin="0,2,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:Loc routing.apps}" Command="{Binding OpenAppsCommand}"
                                Padding="10,4" ToolTip="{loc:Loc tip.apps}" />
                        <Button Content="{loc:Loc routing.directDomains}" Command="{Binding DirectDomainsCommand}"
                                Padding="10,4" Margin="8,0,0,0" ToolTip="{loc:Loc tip.directDomains}" />
                    </StackPanel>

                    <Separator Margin="0,12,0,8" />

                    <TextBlock Text="{loc:Loc dns.title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Loc dns.hint}" Foreground="#666" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,4" />
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{loc:Loc dns.check}"
                                Command="{Binding CheckDnsCommand}" Padding="10,2" Margin="6,0,0,0"
                                ToolTip="{loc:Loc tip.dnsCheck}" />
                        <ComboBox ItemsSource="{Binding DnsProviders}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedDnsProviderId, Mode=TwoWay}" />
                    </DockPanel>

                    <Separator Margin="0,12,0,8" />

                    <TextBlock Text="{loc:Loc routing.failoverTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding FailoverModes}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding SelectedFailoverMode, Mode=TwoWay}" />
                    <TextBlock Text="{Binding GroupHint}" Foreground="#666" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </GroupBox>

            <TextBox Grid.Row="3" Text="{Binding Log, Mode=OneWay}"
                     IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" />

            <!-- Footer: version + language + updates -->
            <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding AppVersion}"
                           Foreground="#999" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Left" Content="{loc:Loc about.button}"
                        Click="About_Click" Padding="10,4" Margin="10,0,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="#888" />
                <Button DockPanel.Dock="Right" Content="{loc:Loc updates.check}"
                        Command="{Binding CheckUpdatesCommand}" Padding="10,4"
                        ToolTip="{loc:Loc tip.updates}" />
                <ComboBox DockPanel.Dock="Right" Width="120" Margin="0,0,8,0"
                          ItemsSource="{Binding Languages}"
                          DisplayMemberPath="NativeName"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                          ToolTip="{loc:Loc footer.language}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
