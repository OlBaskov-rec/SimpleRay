<Window x:Class="SimpleRay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:vm="clr-namespace:SimpleRay.App.ViewModels"
        xmlns:loc="clr-namespace:SimpleRay.App.Localization"
        Title="{Binding WindowTitle}" Height="820" Width="1060" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/tray.ico"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Icon glyph in front of a button label (Segoe MDL2 Assets ships with Windows 10/11). -->
        <Style x:Key="ButtonGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="12" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />  <!-- lists + their buttons -->
            <ColumnDefinition Width="*" />     <!-- connection / routing -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Reserved space on the left for a future Windows startup checkbox. -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,0,0,8" FlowDirection="LeftToRight">
            <Border Width="180" />
            <Button x:Name="LanguageButton" Content="{Binding LanguageShort}" Width="40"
                    Padding="6,4" Margin="0,0,6,0" FontWeight="Bold" Click="Language_Click"
                    ToolTip="{loc:Loc footer.language}" AutomationProperties.Name="{loc:Loc footer.language}">
                <Button.ContextMenu>
                    <ContextMenu ItemsSource="{Binding PlacementTarget.DataContext.Languages, RelativeSource={RelativeSource Self}}">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding NativeName}" />
                                <EventSetter Event="Click" Handler="LanguageMenuItem_Click" />
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="InfoButton" Content="&#x2139;" Width="40" Padding="9,4" FontSize="15"
                    Click="Info_Click" ToolTip="{loc:Loc tip.aboutUpdates}"
                    AutomationProperties.Name="{loc:Loc tip.aboutUpdates}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#F0F0F0" />
                        <Setter Property="BorderBrush" Value="#AAA" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#1F5FA8" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                <Setter Property="Background" Value="#3A8A3F" />
                                <Setter Property="Foreground" Value="White" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.4"
                                                             Duration="0:0:0.4" AutoReverse="True" RepeatBehavior="5x" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding UpdateAvailable}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="#2E6F33" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <Popup x:Name="AboutPopup" PlacementTarget="{Binding ElementName=InfoButton}"
               Placement="Custom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
               Opened="AboutPopup_Opened" PreviewKeyDown="AboutPopup_PreviewKeyDown">
            <Border Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="14"
                    FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
                <StackPanel Width="300" KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Text="SimpleRay" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="{Binding AppVersion}" Foreground="#555" Margin="0,4,0,0" />
                    <TextBlock Text="Copyright (C) 2026 OlBaskov-rec" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" FlowDirection="LeftToRight">
                        <Hyperlink NavigateUri="{x:Static vm:MainViewModel.SourceUrl}" RequestNavigate="Source_RequestNavigate">
                            <Run Text="{x:Static vm:MainViewModel.SourceUrl}" />
                        </Hyperlink>
                    </TextBlock>
                    <Separator Margin="0,8" />
                    <Button x:Name="UpdateButton" Command="{Binding CheckUpdatesCommand}" Padding="10,6">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="{loc:Loc tray.checkUpdates}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                        <Setter Property="Content" Value="{Binding UpdateLinkText}" />
                                        <Setter Property="Background" Value="#3A8A3F" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding UpdateCheckStatus}" TextWrapping="Wrap" FontSize="12"
                               Foreground="#555" Margin="0,6,0,0" />
                    <Button Content="{loc:Loc about.details}" Click="About_Click" HorizontalAlignment="Left"
                            Padding="0,4" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- System tray icon (not rendered in the layout) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="{Binding TrayIcon}"
                        ToolTipText="{Binding TrayToolTip}"
                        TrayMouseDoubleClick="Tray_ShowWindow">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{loc:Loc tray.show}" Click="Tray_ShowWindow" />
                    <MenuItem Header="{loc:Loc tray.toggle}" Click="Tray_ToggleConnect" />
                    <MenuItem Header="{loc:Loc tray.checkUpdates}" Click="Tray_CheckUpdates" />
                    <MenuItem Header="{loc:Loc about.button}" Click="About_Click" />
                    <Separator />
                    <MenuItem Header="{loc:Loc tray.exit}" Click="Tray_Exit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Left side: the lists on top, their buttons below; the lists alone set the width. -->
        <DockPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                   FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
                <!-- Button groups under the lists, one group per row:
                     add · actions on names (subscription or server) · tools.
                     Docked, not spanning grid columns: a span over Auto columns would let the button row
                     stretch the fixed-width server column. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <!-- Add: one menu for every source; each one sorts out servers vs subscriptions itself. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="2" SnapsToDevicePixels="True">
                            <Menu Background="Transparent">
                                <MenuItem Header="{loc:Loc import.add}" Padding="10,4" ToolTip="{loc:Loc tip.subscriptionAdd}">
                                    <MenuItem Header="{loc:Loc import.clipboard}" Command="{Binding ImportClipboardCommand}"
                                              ToolTip="{loc:Loc tip.importClipboard}" />
                                    <MenuItem Header="{loc:Loc import.file}" Command="{Binding ImportFileCommand}"
                                              ToolTip="{loc:Loc tip.importFile}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc import.qrFile}" Command="{Binding ImportQrFileCommand}"
                                              ToolTip="{loc:Loc tip.qrFile}" />
                                    <MenuItem Header="{loc:Loc import.qrClipboard}" Command="{Binding ImportQrClipboardCommand}"
                                              ToolTip="{loc:Loc tip.qrClipboard}" />
                                    <MenuItem Header="{loc:Loc import.qrWebcam}" Command="{Binding ImportQrWebcamCommand}"
                                              ToolTip="{loc:Loc tip.qrWebcam}" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc import.manual}" Command="{Binding ImportManualCommand}"
                                              ToolTip="{loc:Loc tip.importManual}" />
                                </MenuItem>
                            </Menu>
                        </Border>
                    </StackPanel>

                    <!-- Names: act on whichever list was clicked last (a subscription or a server) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{loc:Loc profile.rename}" Command="{Binding RenameCommand}"
                                Padding="10,4" Margin="0,0,6,0" ToolTip="{loc:Loc tip.renameAny}" />
                        <Button Content="{loc:Loc profile.remove}" Command="{Binding RemoveCommand}"
                                Padding="10,4" ToolTip="{loc:Loc tip.removeAny}" />
                    </StackPanel>

                    <!-- Tools -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:Loc profile.ping}" Command="{Binding PingCommand}"
                                Padding="10,4" Margin="0,0,6,0" ToolTip="{loc:Loc tip.ping}">
                        </Button>
                        <Button Content="{loc:Loc profile.pingProxy}" Command="{Binding PingProxyCommand}"
                                Padding="10,4" Margin="0,0,6,0" ToolTip="{loc:Loc tip.pingProxy}">
                        </Button>
                        <Button Content="{loc:Loc profile.speedTest}" Command="{Binding SpeedTestCommand}"
                                Padding="10,4" Margin="0,0,6,0" ToolTip="{loc:Loc tip.speedTest}">
                        </Button>
                        <Button Content="{loc:Loc subscription.refresh}" Command="{Binding RefreshSubscriptionsCommand}"
                                Padding="10,4" Margin="6,0,0,0" ToolTip="{loc:Loc tip.refreshSelected}" />
                    </StackPanel>
                </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- subscriptions panel (collapsible) -->
                    <ColumnDefinition Width="Auto" />  <!-- its vertical toggle -->
                    <ColumnDefinition Width="300" />   <!-- servers -->
                </Grid.ColumnDefinitions>
                <!-- Subscriptions panel: "All servers", "Added manually", each subscription. Picking a row
                     filters the server list. Collapsible via the vertical toggle next to it. -->
                <DockPanel Grid.Column="0" Width="230"
                           Visibility="{Binding IsSubscriptionsPanelOpen, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc subs.title}" FontWeight="SemiBold" Margin="2,0,0,4" />
                    <ListBox ItemsSource="{Binding Sources}"
                             SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                             GotKeyboardFocus="Sources_GotKeyboardFocus"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3,8,3"> <!-- right margin: clear of the scrollbar -->
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Vertical toggle: the arrows point where the panel will go (◀ hide, ▶ show) -->
                <Button Grid.Column="1" Command="{Binding ToggleSubscriptionsPanelCommand}"
                        Width="24" Margin="4,22,4,0" Padding="0" ToolTip="{loc:Loc sources.toggleTip}">
                    <StackPanel>
                        <TextBlock Text="{Binding SubscriptionsToggleArrow}" HorizontalAlignment="Center" Margin="0,6,0,8" />
                        <TextBlock Text="{loc:Loc subs.title}" HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding SubscriptionsToggleArrow}" HorizontalAlignment="Center" Margin="0,8,0,6" />
                    </StackPanel>
                </Button>

                <!-- Server list (filtered by the selected subscription) -->
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ServersHeader}" FontWeight="SemiBold"
                               Margin="2,0,0,4" TextTrimming="CharacterEllipsis" />
                    <ListBox ItemsSource="{Binding ServersView}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             GotKeyboardFocus="Servers_GotKeyboardFocus"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,2,8,2"> <!-- right margin: clear of the scrollbar -->
                                    <!-- Name; the connected server is highlighted green + bold. -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" FontSize="11" Foreground="#3FB950" VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Tag}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="11">
                                        <Run Text="{Binding Protocol}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Server}" />
                                        <Run Text=":" />
                                        <Run Text="{Binding Port}" />
                                    </TextBlock>
                                    <TextBlock Text="{loc:Loc profile.insecure}" FontSize="11" Foreground="#C0392B"
                                               Visibility="{Binding SkipsCertCheck, Converter={StaticResource BoolToVis}}"
                                               ToolTip="{loc:Loc tip.insecure}" />
                                    <!-- "In group" checkbox with the ping latency on the same line, latency indented to the right. -->
                                    <WrapPanel Margin="0,2,0,0"> <!-- wraps when all three figures are shown -->
                                        <CheckBox Content="{loc:Loc profile.inGroup}" FontSize="11" VerticalAlignment="Center"
                                                  IsChecked="{Binding InGroup, Mode=TwoWay}"
                                                  Command="{Binding DataContext.GroupChangedCommand,
                                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  ToolTip="{loc:Loc tip.inGroup}" />
                                        <TextBlock FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding LatencyText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- Reachable: green ms. Unreachable: gray dash. Never pinged: hidden. -->
                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LatencyMs}" Value="{x:Null}">
                                                            <Setter Property="Foreground" Value="Gray" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LatencyText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Ping through the server: green ms = works, red = no answer, gray … = running. -->
                                        <TextBlock FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding ProxyLatencyText}" ToolTip="{loc:Loc tip.pingProxy}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProxyLatencyMs}" Value="{x:Null}">
                                                            <Setter Property="Foreground" Value="#C0392B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ProxyLatencyText}" Value="…">
                                                            <Setter Property="Foreground" Value="Gray" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ProxyLatencyText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Speed test of this server (on demand): ↓ Mbit/s -->
                                        <TextBlock FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding SpeedText}" Foreground="#1F5FA8" ToolTip="{loc:Loc tip.speedTest}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SpeedText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- Right panel -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="12,0,0,0"
              FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="{Binding ConnectButtonText}"
                    Command="{Binding ConnectCommand}"
                    Height="44" FontSize="15" FontWeight="SemiBold" ToolTip="{loc:Loc tip.connect}" />

            <StackPanel Grid.Row="1" Margin="2,10">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#333" />
                <!-- Provider info for the selected server's subscription (title, traffic, expiry, announce) -->
                <TextBlock Text="{Binding SubscriptionInfo}" TextWrapping="Wrap" Foreground="#666"
                           FontSize="11" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SubscriptionInfo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Provider links for that subscription; each collapses when the provider didn't send it -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Margin="0,0,14,0" FontSize="11">
                        <Hyperlink Command="{Binding OpenSupportCommand}" ToolTip="{Binding SubscriptionSupportUrl}">
                            <Run Text="{loc:Loc sub.support}" />
                        </Hyperlink>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SubscriptionSupportUrl}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Margin="0,0,14,0" FontSize="11">
                        <Hyperlink Command="{Binding OpenWebPageCommand}" ToolTip="{Binding SubscriptionWebPageUrl}">
                            <Run Text="{loc:Loc sub.website}" />
                        </Hyperlink>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SubscriptionWebPageUrl}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Routing settings -->
            <GroupBox Grid.Row="2" Header="{loc:Loc routing.title}" Padding="8,4" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="{loc:Loc routing.mode}" Foreground="#666" Margin="0,0,0,2" />
                    <!-- ItemTemplate (not DisplayMemberPath) so the closed box re-renders the
                         label when the language changes; the items themselves never change. -->
                    <ComboBox ItemsSource="{Binding Modes}"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding SelectedMode, Mode=TwoWay}"
                              TextSearch.TextPath="Label"
                              ToolTip="{loc:Loc tip.mode}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Direct, bypassing the VPN (Rules mode): geo sets, then the user's own lists. -->
                    <TextBlock Text="{loc:Loc routing.directHint}"
                               Foreground="#666" Margin="0,10,0,2" TextWrapping="Wrap" />
                    <CheckBox Content="{loc:Loc routing.directRuSites}"
                              IsChecked="{Binding DirectRuSites, Mode=TwoWay}"
                              IsEnabled="{Binding IsRuleMode}" Margin="0,2,0,0" ToolTip="{loc:Loc tip.directRuSites}" />
                    <CheckBox Content="{loc:Loc routing.directRuIp}"
                              IsChecked="{Binding DirectRuIp, Mode=TwoWay}"
                              IsEnabled="{Binding IsRuleMode}" Margin="0,2,0,0" ToolTip="{loc:Loc tip.directRuIp}" />
                    <CheckBox Content="{loc:Loc routing.directLan}"
                              IsChecked="{Binding DirectLan, Mode=TwoWay}"
                              IsEnabled="{Binding IsRuleMode}" Margin="0,2,0,0" ToolTip="{loc:Loc tip.directLan}" />

                    <!-- The user's own routing lists. Each button carries a glyph for what it routes:
                         a program window (per-app rules, either way), a globe (sites direct),
                         a shield (sites through the VPN). -->
                    <Border Background="#F6F8FA" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="4"
                            Padding="8,6,8,2" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc routing.listsTitle}" Foreground="#555" FontSize="12" Margin="0,0,0,4" />
                            <WrapPanel>
                                <Button Command="{Binding OpenAppsCommand}" Padding="10,4" Margin="0,0,8,6"
                                        ToolTip="{loc:Loc tip.apps}" AutomationProperties.Name="{loc:Loc routing.apps}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE737;" />
                                        <TextBlock Text="{loc:Loc routing.apps}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DirectDomainsCommand}" Padding="10,4" Margin="0,0,8,6"
                                        ToolTip="{loc:Loc tip.directDomains}" AutomationProperties.Name="{loc:Loc routing.directDomains}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xE774;" />
                                        <TextBlock Text="{loc:Loc routing.directDomains}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ProxyDomainsCommand}" Padding="10,4" Margin="0,0,0,6"
                                        ToolTip="{loc:Loc tip.proxyDomains}" AutomationProperties.Name="{loc:Loc routing.proxyDomains}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ButtonGlyph}" Text="&#xEA18;" />
                                        <TextBlock Text="{loc:Loc routing.proxyDomains}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <CheckBox Content="{loc:Loc routing.blockAds}"
                              IsChecked="{Binding BlockAds, Mode=TwoWay}"
                              ToolTip="{loc:Loc tip.blockAds}" Margin="0,12,0,0" />
                    <CheckBox Content="{loc:Loc routing.autoConnect}"
                              IsChecked="{Binding AutoConnect, Mode=TwoWay}"
                              ToolTip="{loc:Loc tip.autoConnect}" Margin="0,6,0,0" />
                    <CheckBox Content="{loc:Loc routing.killSwitch}"
                              IsChecked="{Binding KillSwitchEnabled, Mode=TwoWay}"
                              ToolTip="{loc:Loc tip.killSwitch}" Margin="0,6,0,0" />
                    <CheckBox Content="{loc:Loc routing.enableIpv6}"
                              IsChecked="{Binding EnableIpv6, Mode=TwoWay}"
                              ToolTip="{loc:Loc tip.enableIpv6}" Margin="0,6,0,0" />

                    <Separator Margin="0,12,0,8" />

                    <TextBlock Text="{loc:Loc dns.title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="{loc:Loc dns.hint}" Foreground="#666" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,4" />
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{loc:Loc dns.check}"
                                Command="{Binding CheckDnsCommand}" Padding="10,2" Margin="6,0,0,0"
                                ToolTip="{loc:Loc tip.dnsCheck}" />
                        <ComboBox ItemsSource="{Binding DnsProviders}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedDnsProviderId, Mode=TwoWay}"
                                  ToolTip="{loc:Loc tip.dnsProvider}" />
                    </DockPanel>

                    <Separator Margin="0,12,0,8" />

                    <TextBlock Text="{loc:Loc routing.failoverTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <CheckBox Content="{loc:Loc routing.autoSwitch}"
                              IsChecked="{Binding AutoSwitch, Mode=TwoWay}"
                              ToolTip="{loc:Loc tip.autoSwitch}" />
                    <TextBlock Text="{Binding GroupHint}" Foreground="#666" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </GroupBox>

            <TextBox Grid.Row="3" Text="{Binding Log, Mode=OneWay}"
                     IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" />

        </Grid>
    </Grid>
</Window>
