<Window x:Class="SimpleRay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="SimpleRay" Height="560" Width="760"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/tray.ico"
        StateChanged="Window_StateChanged"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- System tray icon (not rendered in the layout) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/Resources/tray.ico"
                        ToolTipText="SimpleRay"
                        TrayMouseDoubleClick="Tray_ShowWindow">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Показать" Click="Tray_ShowWindow" />
                    <MenuItem Header="Подключить / Отключить" Click="Tray_ToggleConnect" />
                    <Separator />
                    <MenuItem Header="Выход" Click="Tray_Exit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Profile list -->
        <ListBox Grid.Row="0" Grid.Column="0"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2" LastChildFill="True">
                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,2,0"
                                  Content="в группу"
                                  IsChecked="{Binding InGroup, Mode=TwoWay}"
                                  Command="{Binding DataContext.GroupChangedCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  ToolTip="Включить этот сервер в группу автопереключения" />
                        <StackPanel>
                            <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="Gray" FontSize="11">
                                <Run Text="{Binding Protocol}" />
                                <Run Text=" · " />
                                <Run Text="{Binding Server}" />
                                <Run Text=":" />
                                <Run Text="{Binding Port}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Profile actions -->
        <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
            <Button Content="Из буфера" Command="{Binding ImportClipboardCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="Импорт ссылок / WireGuard-конфига из буфера обмена" />
            <Button Content="Файл…" Command="{Binding ImportFileCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="Импорт из файла .conf (WireGuard) или .txt со ссылками" />
            <Button Content="QR из файла" Command="{Binding ImportQrFileCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="Импорт из изображения с QR-кодом" />
            <Button Content="QR из буфера" Command="{Binding ImportQrClipboardCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="Распознать QR из картинки в буфере обмена" />
            <Button Content="QR с камеры" Command="{Binding ImportQrWebcamCommand}"
                    Padding="10,4" Margin="0,0,6,6" ToolTip="Сканировать QR-код с web-камеры" />
            <Button Content="Удалить" Command="{Binding RemoveCommand}"
                    Padding="10,4" Margin="0,0,0,6" />
        </WrapPanel>

        <!-- Right panel -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="{Binding ConnectButtonText}"
                    Command="{Binding ConnectCommand}"
                    Height="44" FontSize="15" FontWeight="SemiBold" />

            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="2,10"
                       TextWrapping="Wrap" Foreground="#333" />

            <!-- Routing settings -->
            <GroupBox Grid.Row="2" Header="Маршрутизация" Padding="8,4" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Режим" Foreground="#666" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding Modes}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding SelectedMode, Mode=TwoWay}" />

                    <CheckBox Content="Блокировать рекламу и трекеры"
                              IsChecked="{Binding BlockAds, Mode=TwoWay}"
                              Margin="0,10,0,0" />

                    <TextBlock Text="Напрямую, минуя VPN (в режиме «По правилам»):"
                               Foreground="#666" Margin="0,10,0,2" TextWrapping="Wrap" />
                    <CheckBox Content="Российские сайты (geosite-ru)"
                              IsChecked="{Binding DirectRuSites, Mode=TwoWay}"
                              IsEnabled="{Binding IsRuleMode}" Margin="0,2,0,0" />
                    <CheckBox Content="Российские IP (geoip-ru)"
                              IsChecked="{Binding DirectRuIp, Mode=TwoWay}"
                              IsEnabled="{Binding IsRuleMode}" Margin="0,2,0,0" />
                    <CheckBox Content="Локальная сеть (private)"
                              IsChecked="{Binding DirectLan, Mode=TwoWay}"
                              IsEnabled="{Binding IsRuleMode}" Margin="0,2,0,0" />

                    <Button Content="Приложения…" Command="{Binding OpenAppsCommand}"
                            HorizontalAlignment="Left" Padding="10,4" Margin="0,12,0,0"
                            ToolTip="Выбрать приложения: через VPN или напрямую" />

                    <Separator Margin="0,12,0,8" />

                    <TextBlock Text="Группа каналов (автопереключение)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding FailoverModes}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Mode"
                              SelectedValue="{Binding SelectedFailoverMode, Mode=TwoWay}" />
                    <TextBlock Text="{Binding GroupHint}" Foreground="#666" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </GroupBox>

            <TextBox Grid.Row="3" Text="{Binding Log, Mode=OneWay}"
                     IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" />
        </Grid>
    </Grid>
</Window>
